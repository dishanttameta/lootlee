{%- doc -%}
  Renders a view product link button component on product cards.

  @param {object} product - The product object
  @param {string} [section_id] - The section ID
  @param {object} [block] - The block object
  @param {string} [color_scheme] - The color scheme to use
{%- enddoc -%}

{% liquid
  assign is_combo = false
  if product.template_suffix == 'combo'
    assign is_combo = true
  else
    for tag in product.tags
      assign tag_lower = tag | downcase
      if tag_lower == 'combo'
        assign is_combo = true
      endif
    endfor
  endif
%}

{%- unless is_combo -%}
{% liquid
  assign view_product_text = 'View product'
  assign color_scheme = color_scheme | default: settings.quick_add_color_scheme

  # Logic to determine which variant to use (matching swatch selection logic from product-card)
  assign variant = product.selected_or_first_available_variant
  assign product_url = variant.url | default: product.url
%}

<div
  class="quick-add color-{{ color_scheme }}"
  ref="quickAdd"
>
  <a
    href="{{ product_url }}"
    class="button quick-add__button add-to-cart-button view-product-button"
    aria-label="{{ view_product_text }}: {{ product.title | escape }}"
  >
    <span class="add-to-cart-text">
      <span class="add-to-cart-text__content">
        <span>
          <span>
            {{ view_product_text }}
          </span>
        </span>
      </span>
    </span>
  </a>
</div>
{%- endunless -%}

{% render 'quick-add-styles' %}

