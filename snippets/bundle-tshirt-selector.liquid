{%- doc -%}
  Headless bundle data handler for products with custom.bundle_enabled metafield.
  Invisible on the frontend; handles background multi-line cart submission and live price updates when "With T-Shirt" is selected.

  @param {object} product - The product object
  @param {object} section - The section object
  @param {object} [block] - The block object
{%- enddoc -%}

{%- if product.metafields.custom.bundle_enabled.value -%}
  {%- liquid
    assign extra_product = product.metafields.custom.extra_tshirt_product.value
    assign unit_price_raw = product.metafields.custom.tshirt_unit_price.value
    assign unit_price_cents = 0

    if unit_price_raw != blank
      assign unit_price_str = unit_price_raw | append: ''
      if unit_price_str contains '.'
        assign parts = unit_price_str | split: '.'
        assign major = parts[0] | times: 100
        assign minor = parts[1] | slice: 0, 2
        if minor.size == 1
          assign minor = minor | append: '0'
        endif
        assign minor = minor | times: 1
        assign unit_price_cents = major | plus: minor
      else
        if extra_product != blank and extra_product.price > 0 and unit_price_raw == extra_product.price
          assign unit_price_cents = unit_price_raw
        elsif unit_price_raw < 10000
          assign unit_price_cents = unit_price_raw | times: 100
        else
          assign unit_price_cents = unit_price_raw
        endif
      endif
    elsif extra_product != blank and extra_product.price > 0
      assign unit_price_cents = extra_product.price
    endif

    assign current_variant = product.selected_or_first_available_variant
    assign formatted_unit_price = unit_price_cents | money
  -%}

  <bundle-tshirt-selector
    class="bundle-tshirt-selector"
    style="display: none !important;"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-extra-product-title="{{ extra_product.title | default: 'T-Shirt' | escape }}"
    data-base-price="{{ current_variant.price }}"
    data-unit-price-cents="{{ unit_price_cents }}"
    data-formatted-unit-price="{{ formatted_unit_price | escape }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <script type="application/json" ref="extraProductData">
      {
        "variants": {
          {%- if extra_product != blank -%}
            {%- for v in extra_product.variants -%}
              {%- liquid
                assign opt1_clean = v.option1 | strip
                assign opt2_clean = v.option2 | strip
                assign opt3_clean = v.option3 | strip
                assign title_clean = v.title | strip
              -%}
              {{ opt1_clean | json }}: {{ v.id | json }},
              {{ opt1_clean | downcase | json }}: {{ v.id | json }},
              {%- if opt2_clean != blank and opt2_clean != 'Default Title' -%}
                {{ opt2_clean | json }}: {{ v.id | json }},
                {{ opt2_clean | downcase | json }}: {{ v.id | json }},
              {%- endif -%}
              {%- if opt3_clean != blank and opt3_clean != 'Default Title' -%}
                {{ opt3_clean | json }}: {{ v.id | json }},
                {{ opt3_clean | downcase | json }}: {{ v.id | json }},
              {%- endif -%}
              {{ title_clean | json }}: {{ v.id | json }},
              {{ title_clean | downcase | json }}: {{ v.id | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        },
        "unitPriceCents": {{ unit_price_cents | json }},
        "extraProductId": {{ extra_product.id | default: 0 | json }}
      }
    </script>

    <script type="application/json" ref="mainProductVariants">
      [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id | json }},
            "title": {{ v.title | json }},
            "price": {{ v.price | json }},
            "compare_at_price": {{ v.compare_at_price | json }},
            "options": {{ v.options | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  </bundle-tshirt-selector>

  <script src="{{ 'bundle-tshirt.js' | asset_url }}" type="module"></script>
{%- endif -%}
