<!-- CUSTOM ZOOM MODAL -->
<div id="shirts-zoom-modal" class="shirts-zoom-modal" style="display: none;">
  <span class="shirts-zoom-close" id="shirts-zoom-close">&times;</span>
  <img class="shirts-zoom-content" id="shirts-zoom-img" alt="Zoomed view">
</div>

<script>
  (function() {
    document.addEventListener("click", function (e) {
      const btn = e.target.closest(".shirts-view-fullscreen-btn");
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const parent = btn.parentElement;
        let img = parent ? parent.querySelector("img") : null;
        if (!img && parent) {
          const container = parent.closest(".product-media") || parent.closest(".shirts-product__main-image");
          if (container) {
            img = container.querySelector("img");
          }
        }
        if (img) {
          const modal = document.getElementById("shirts-zoom-modal");
          const modalImg = document.getElementById("shirts-zoom-img");
          if (modal && modalImg) {
            modal.style.display = "flex";
            let imgSrc = img.src || img.getAttribute("src");
            if (imgSrc) {
              imgSrc = imgSrc.replace(/width=\d+/, "width=2000");
            }
            modalImg.src = imgSrc;
          }
        }
      }
    });

    document.addEventListener("click", function (e) {
      const modal = document.getElementById("shirts-zoom-modal");
      if (modal && modal.style.display === "flex") {
        const closeBtn = document.getElementById("shirts-zoom-close");
        if (e.target === modal || e.target === closeBtn || e.target.classList.contains("shirts-zoom-close")) {
          modal.style.display = "none";
        }
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        const modal = document.getElementById("shirts-zoom-modal");
        if (modal) modal.style.display = "none";
      }
    });
  })();
</script>

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(8px, var(--style-border-radius-buttons-primary))
    );
    box-shadow: var(--shadow-popover);
    padding: 10px 16px;
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: 12px;

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-left: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: 44px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant-price-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin: 0;
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
    font-size: 13px !important;
  }

  .sticky-add-to-cart__price .custom-pricing-layout {
    margin: 0 !important;
    gap: 6px !important;
  }

  .sticky-add-to-cart__price * {
    font-size: 13px !important;
    line-height: 1.2 !important;
  }

  .sticky-add-to-cart__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sticky-add-to-cart__button,
  .sticky-add-to-cart__buy-now {
    height: var(--height-buy-buttons, 44px);
    position: relative;
    white-space: nowrap;
    padding-inline: 20px;
    border-radius: 100px !important;
    font-weight: 500;
    font-size: 13px;
    border: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: none !important;
    outline: none !important;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .sticky-add-to-cart__button {
    background-color: #f3f4f6 !important;
    color: #000000 !important;
  }

  .shirts-features__container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
  }
  .shirts-features-grid-wrapper {
    max-width: 1440px;
  }

  .sticky-add-to-cart__buy-now {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .sticky-add-to-cart__button:hover,
  .sticky-add-to-cart__buy-now:hover {
    opacity: 0.9;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 0;
      padding: 10px var(--padding-sm);
      gap: 10px;

      &::before {
        --border: 1px;
      }
    }

    .shirts-features-grid-wrapper {
      max-width: 1440px;
    }

    .sticky-add-to-cart__actions {
      flex: 1.5;
      justify-content: flex-end;
      gap: 6px;
    }

    .sticky-add-to-cart__button,
    .sticky-add-to-cart__buy-now {
      flex: 1;
      max-width: 110px;
      font-size: 12px;
      padding-inline: 6px !important;
      height: 38px !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 100px !important;
    }

    .sticky-add-to-cart__button .add-to-cart-icon {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__price {
      font-size: 12px !important;
    }

    .sticky-add-to-cart__price * {
      font-size: 12px !important;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button,
    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__buy-now {
      width: auto;
      max-width: none;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Combo products"
    },
    {
      "type": "collection",
      "id": "shirts_collection",
      "label": "Shirts Collection",
      "info": "Select the collection containing all shirts available in the combo."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
