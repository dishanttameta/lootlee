              "disabled": true,
              "settings": {
                "custom_liquid": "<div class=\"offer-timer-box\">\n  <div class=\"offer-text\">\n    Hurry up, Shop Now !\n  </div>\n\n  <div class=\"offer-timer\" id=\"loopTimer\">\n    05:00:00\n  </div>\n</div>\n\n<style>\n.offer-timer-box{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  width:100%;\n  background:#ffffff;\n  border:2px dashed #ff0000;\n  border-radius:8px;\n  padding:12px 16px;\n  margin:1px 0;\n  box-sizing:border-box;\n}\n\n.offer-text{\n  color:#ff0000;\n  font-size:16px;\n  font-weight:700;\n}\n\n.offer-timer{\n  color:#ff0000;\n  font-size:18px;\n  font-weight:700;\n  letter-spacing:1px;\n}\n</style>\n\n<script>\n(function() {\n\n  const FIVE_HOURS = 5 * 60 * 60;\n\n  function startLoopTimer() {\n\n    let endTime = Date.now() + (FIVE_HOURS * 1000);\n\n    function updateTimer() {\n\n      let remaining = Math.floor((endTime - Date.now()) / 1000);\n\n      if (remaining <= 0) {\n        endTime = Date.now() + (FIVE_HOURS * 1000);\n        remaining = FIVE_HOURS;\n      }\n\n      const hours = Math.floor(remaining / 3600);\n      const minutes = Math.floor((remaining % 3600) / 60);\n      const seconds = remaining % 60;\n\n      document.getElementById('loopTimer').innerHTML =\n        String(hours).padStart(2,'0') + ':' +\n        String(minutes).padStart(2,'0') + ':' +\n        String(seconds).padStart(2,'0');\n    }\n\n    updateTimer();\n    setInterval(updateTimer, 1000);\n  }\n\n  startLoopTimer();\n\n})();\n</script>"
