<div class="shirts-trust-badge-bar" {{ block.shopify_attributes }}>
  <div class="shirts-trust-badge">
    <span class="shirts-trust-icon">
      {%- if block.settings.badge_1_image != blank -%}
        {{ block.settings.badge_1_image | image_url: width: 60 | image_tag: class: 'custom-badge-img', alt: block.settings.badge_1_image.alt | escape }}
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
      {%- endif -%}
    </span>
    <div class="shirts-trust-text">
      <span class="shirts-trust-title">{{ block.settings.badge_1_title }}</span>
      <span>{{ block.settings.badge_1_text }}</span>
    </div>
  </div>
  {%- if block.settings.badge_2_title != blank or block.settings.badge_2_image != blank -%}
    <div class="shirts-trust-divider"></div>
    <div class="shirts-trust-badge">
      <span class="shirts-trust-icon">
        {%- if block.settings.badge_2_image != blank -%}
          {{ block.settings.badge_2_image | image_url: width: 60 | image_tag: class: 'custom-badge-img', alt: block.settings.badge_2_image.alt | escape }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        {%- endif -%}
      </span>
      <div class="shirts-trust-text">
        <span class="shirts-trust-title">{{ block.settings.badge_2_title }}</span>
        <span>{{ block.settings.badge_2_text }}</span>
      </div>
    </div>
  {%- endif -%}
  <div class="shirts-trust-divider"></div>
  <div class="shirts-trust-badge">
    <span class="shirts-trust-icon">
      {%- if block.settings.badge_3_image != blank -%}
        {{ block.settings.badge_3_image | image_url: width: 60 | image_tag: class: 'custom-badge-img', alt: block.settings.badge_3_image.alt | escape }}
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      {%- endif -%}
    </span>
    <div class="shirts-trust-text">
      <span class="shirts-trust-title">{{ block.settings.badge_3_title }}</span>
      <span>{{ block.settings.badge_3_text }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Badge Bar",
  "settings": [
    {
      "type": "image_picker",
      "id": "badge_1_image",
      "label": "Badge 1 Custom Icon/Image"
    },
    {
      "type": "text",
      "id": "badge_1_title",
      "label": "Badge 1 Title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "on prepaid orders"
    },
    {
      "type": "image_picker",
      "id": "badge_2_image",
      "label": "Badge 2 Custom Icon/Image"
    },
    {
      "type": "text",
      "id": "badge_2_title",
      "label": "Badge 2 Title"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text"
    },
    {
      "type": "image_picker",
      "id": "badge_3_image",
      "label": "Badge 3 Custom Icon/Image"
    },
    {
      "type": "text",
      "id": "badge_3_title",
      "label": "Badge 3 Title",
      "default": "100% Secure"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Payments"
    }
  ],
  "presets": [
    {
      "name": "Trust Badge Bar"
    }
  ]
}
{% endschema %}
